{"id":"6090000","name":"厄運死神","level":65,"desc":"等級：Lv.65 型態：不死系 很久以前，有一位受所有人尊敬的祭司，他有著十分強大的力量。隨著死亡的臨近，他竟然背棄了神，而與惡魔簽下了契約。最後犯了天怒而死去，後來被他的擁護者埋到了死亡森林。已經很久很久了… 死亡森林最後成了僵屍們的巢穴，為了消滅它們，湧現出了很多的英雄。由於英雄們的努力，僵屍們的立足之地越來越小，最後竟然復活了墮落的祭司，使之成為了守護者。復活的祭司自詡為‘厄運死神’，成為了死亡森林的統治者，控制了所有僵屍。‘厄運死神’雖為不死系，但曾是受人尊敬的祭司，所以對‘神聖屬性’的抗性很高，並擁有強大的魔法和放逐技能，想要打敗它並不容易。應該想一想除了武力還有什麼其他辦法。","stats":{"MADamage":270,"MDDamage":400,"PADamage":180,"PDDamage":200,"acc":150,"bodyAttack":1,"boss":1,"eva":999,"exp":255,"level":65,"maxHP":11000,"maxMP":500,"pushed":1000,"removeAfter":1800,"speed":-30,"undead":1},"boss":true,"elemental":{"summary":"一般","values":{"fire":"normal","ice":"normal","lightning":"normal","poison":"normal","holy":"normal"}},"meso":{"min":null,"max":null,"note":"","unverified":true},"maps":[{"id":211041100,"street":"","name":"亡者之林Ⅰ","region":"廢礦","spawns":null,"link":true,"source":"monsterBook","sourceLabel":"怪物圖鑑標註","spawnNote":"未提供重生座標","coordinateMissing":true,"regionSource":"worldMap","sourceEvidence":[{"spawnNote":"未提供重生座標","regionSource":"worldMap","sourceNote":"未提供重生座標"},{"source":"monsterBook","sourceLabel":"怪物圖鑑標註","coordinateMissing":true,"sourceNote":"怪物圖鑑標註"}],"sourceNote":"怪物圖鑑標註；未提供重生座標"},{"id":211041200,"street":"","name":"亡者之林Ⅱ","region":"廢礦","spawns":null,"link":true,"source":"monsterBook","sourceLabel":"怪物圖鑑標註","spawnNote":"未提供重生座標","coordinateMissing":true,"regionSource":"worldMap","sourceEvidence":[{"spawnNote":"未提供重生座標","regionSource":"worldMap","sourceNote":"未提供重生座標"},{"source":"monsterBook","sourceLabel":"怪物圖鑑標註","coordinateMissing":true,"sourceNote":"怪物圖鑑標註"}],"sourceNote":"怪物圖鑑標註；未提供重生座標"},{"id":211041300,"street":"","name":"亡者之林Ⅲ","region":"廢礦","spawns":null,"link":true,"source":"monsterBook","sourceLabel":"怪物圖鑑標註","spawnNote":"未提供重生座標","coordinateMissing":true,"regionSource":"worldMap","sourceEvidence":[{"spawnNote":"未提供重生座標","regionSource":"worldMap","sourceNote":"未提供重生座標"},{"source":"monsterBook","sourceLabel":"怪物圖鑑標註","coordinateMissing":true,"sourceNote":"怪物圖鑑標註"}],"