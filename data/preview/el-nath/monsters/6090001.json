{"id":"6090001","name":"雪山魔女","level":64,"desc":"等級：Lv.64 型態：精怪 不明來歷的雪山魔女。在冰原雪域獵人中有這樣一個傳說，傳說魔女是冰原雪域山脈的主人，如果想在冰原雪域山脈打獵，必須得到她的許可。實際上，是因為獵人們與雪吉拉相比，要更加懼怕連實體都看不到的亡靈。據冰原雪域的獵人斯卡圖勒說，亡靈十分可怕，但卻有著美麗的女性外表…。 如果在狩獵途中遇到了亡靈，可以獻出一些在冰原雪域山脈獵人祭壇處的怪物那裡得到的戰利品。","stats":{"MADamage":230,"MDDamage":230,"PADamage":177,"PDDamage":190,"acc":140,"bodyAttack":1,"boss":1,"eva":999,"exp":250,"level":64,"maxHP":7700,"maxMP":200,"pushed":800,"removeAfter":1800,"speed":-50,"undead":0},"boss":true,"elemental":{"summary":"一般","values":{"fire":"normal","ice":"normal","lightning":"normal","poison":"normal","holy":"normal"}},"meso":{"min":null,"max":null,"note":"","unverified":true},"maps":[{"id":211010000,"street":"","name":"冰面Ⅰ","region":"冰原雪域","spawns":null,"link":true,"source":"monsterBook","sourceLabel":"怪物圖鑑標註","spawnNote":"未提供重生座標","coordinateMissing":true,"regionSource":"worldMap","sourceEvidence":[{"spawnNote":"未提供重生座標","regionSource":"worldMap","sourceNote":"未提供重生座標"},{"source":"monsterBook","sourceLabel":"怪物圖鑑標註","coordinateMissing":true,"sourceNote":"怪物圖鑑標註"}],"sourceNote":"怪物圖鑑標註；未提供重生座標"},{"id":211020000,"street":"","name":"冰面Ⅱ","region":"冰原雪域","spawns":null,"link":true,"source":"monsterBook","sourceLabel":"怪物圖鑑標註","spawnNote":"未提供重生座標","coordinateMissing":true,"regionSource":"worldMap","sourceEvidence":[{"spawnNote":"未提供重生座標","regionSource":"worldMap","sourceNote":"未提供重生座標"},{"source":"monsterBook","sourceLabel":"怪物圖鑑標註","coordinateMissing":true,"sourceNote":"怪物圖鑑標註"}],"sourceNote":"怪物圖鑑標註；未提供重生座標"},{"id":211050000,"street":"","name":"寒冰平原","region":"冰原雪域","spawns":null,"link":true,"source":"monsterBook","sourceLabel":"怪物圖鑑標註","spawnNote":"未提供重生座標","coordinateMissing":true,"regionSource":"worldMap","sourceEvidence":[{"spawnNote":"未提供重生座標","regionSource":"worldMap","sourceNote":"未提供重生座標"},{"source":"monsterBook","sourceLabel":"怪物圖鑑標註","coordinateMissing":true,"sourceNote":"怪物圖鑑標註"}],"sourceNote":"怪物圖鑑標註；未提供重生座標"}],"drops":[{"id":4000415,"name":"冰之淚","cat":"其他","sub":"掉落道具","link":true,"sourc